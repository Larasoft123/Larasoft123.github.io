---
import Layout from "@/layouts/Layout.astro";
import Skills from "@/sections/Skills.astro";
import Intro from "@/sections/Intro.astro";
import Projects from "@/sections/Projects.astro";
import ExperienceSection from "@/sections/ExperienceSection.astro";
import CertificationsSection from "@/sections/CertificationsSection.astro";
import Contact from "@/sections/Contact.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = `${t('presentation.name')} - ${t('presentation.title')}`;
const description = t('presentation.description');
---

<Layout
  title={title}
  description={description}
>
  <Intro />
  <ExperienceSection />
  <Projects />
  <Skills />
  <CertificationsSection />
  <Contact />
</Layout>
