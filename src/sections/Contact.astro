---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import Button from "@/components/Button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="nav.contact"
  class="container mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32"
>
  <div class="max-w-3xl mx-auto text-center mb-16">
    <h2
      class="text-4xl font-black tracking-tight text-text-main sm:text-6xl mb-6"
    >
      {t("contact.title")}
    </h2>
    <p class="text-xl leading-relaxed text-text-muted">
      {t("contact.desc")}
    </p>
  </div>

  <div class="mt-16 max-w-2xl mx-auto">
    <div
      class="glass-panel p-8 md:p-12 rounded-[2.5rem] shadow-2xl relative overflow-hidden"
    >
      <!-- Background Accents -->
      <div
        class="absolute -top-24 -right-24 w-64 h-64 bg-primary/10 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute -bottom-24 -left-24 w-64 h-64 bg-accent/10 rounded-full blur-3xl"
      >
      </div>

      <form method="post" class="relative z-10 space-y-8">
        {/* Anti-spam honeypot */}
        <input
          type="text"
          name="_honey"
          style="display:none"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="space-y-2">
            <label
              class="text-sm font-bold text-text-main ml-1 uppercase tracking-wider"
              for="name">{t("contact.form.name")}</label
            >
            <input
              autocomplete="name"
              class="w-full px-6 py-4 rounded-2xl bg-surface/50 border border-primary/10 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-text-main"
              id="name"
              name="name"
              required
              type="text"
            />
          </div>
          <div class="space-y-2">
            <label
              class="text-sm font-bold text-text-main ml-1 uppercase tracking-wider"
              for="email">{t("contact.form.email")}</label
            >
            <input
              autocomplete="email"
              class="w-full px-6 py-4 rounded-2xl bg-surface/50 border border-primary/10 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-text-main"
              id="email"
              name="email"
              required
              type="email"
            />
          </div>
        </div>

        <div class="space-y-2">
          <label
            class="text-sm font-bold text-text-main ml-1 uppercase tracking-wider"
            for="subject">{t("contact.form.subject")}</label
          >
          <input
            class="w-full px-6 py-4 rounded-2xl bg-surface/50 border border-primary/10 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-text-main"
            id="subject"
            name="subject"
            required
            type="text"
          />
        </div>

        <div class="space-y-2">
          <label
            class="text-sm font-bold text-text-main ml-1 uppercase tracking-wider"
            for="message">{t("contact.form.message")}</label
          >
          <textarea
            class="w-full px-6 py-4 rounded-2xl bg-surface/50 border border-primary/10 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-text-main min-h-[150px]"
            id="message"
            name="message"
            required
            rows="5"></textarea>
        </div>

        <div class="flex flex-col items-center pt-4 gap-4">
          <Button
            text={t("contact.form.btn")}
            variant="primary"
            type="submit"
          />

          <!-- Spinner -->
          <div id="loading-spinner" class="hidden">
            <svg
              class="animate-spin h-6 w-6 text-primary"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              ></path>
            </svg>
          </div>

          <!-- Error Feedback -->
          <div
            id="error-message"
            class="hidden text-red-500 text-sm font-bold text-center max-w-md"
          >
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import confetti from "canvas-confetti";

  const form = document.querySelector("form");
  const submitButton = form?.querySelector(
    'button[type="submit"], input[type="submit"]',
  );
  const spinner = document.getElementById("loading-spinner");
  const errorMessage = document.getElementById("error-message");

  form?.addEventListener("submit", async (e: Event) => {
    e.preventDefault();

    const currentForm = e.target as HTMLFormElement;
    const formData = new FormData(currentForm);

    
    if (errorMessage) {
      errorMessage.classList.add("hidden");
      errorMessage.textContent = "";
    }
    if (spinner) spinner.classList.remove("hidden");
    if (submitButton) submitButton.setAttribute("disabled", "true");

    try {
      const response = await fetch("/api/send", {
        method: "POST",
        body: formData,
      });

      const data = await response.json();

      if (response.ok) {
        confetti({
          particleCount: 100,
          spread: 70,
          origin: { y: 0.6 },
        });
        currentForm.reset();
      } else {
        const errorText =
          data.message ||
          (typeof data.error === "string" ? data.error : data.error?.message) ||
          "Ocurrió un error inesperado al enviar el mensaje.";
        if (errorMessage) {
          errorMessage.classList.remove("hidden");
          errorMessage.textContent = errorText;
        }
      }
    } catch (error) {
      if (errorMessage) {
        errorMessage.classList.remove("hidden");
        errorMessage.textContent = "Vuelve a intentarlo más tarde.";
      }
    } finally {
      
      if (spinner) spinner.classList.add("hidden");
      if (submitButton) submitButton.removeAttribute("disabled");
    }
  });
</script>
