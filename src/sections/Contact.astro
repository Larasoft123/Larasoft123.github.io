---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import Button from "@/components/Button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="nav.contact"
  class="container mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32"
>
  <div class="max-w-3xl mx-auto text-center mb-16">
    <h2 class="text-4xl font-black tracking-tight text-text-main sm:text-6xl mb-6">
      {t('contact.title')}
    </h2>
    <p class="text-xl leading-relaxed text-text-muted">
      {t('contact.desc')}
    </p>
  </div>
  
  <div class="mt-16 max-w-2xl mx-auto">
    <div
      class="glass-panel p-8 md:p-12 rounded-[2.5rem] shadow-2xl relative overflow-hidden"
    >
      <!-- Background Accents -->
      <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-accent/10 rounded-full blur-3xl"></div>

      <form action="#" class="relative z-10 space-y-8" method="POST">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="space-y-2">
            <label class="text-sm font-bold text-text-main ml-1 uppercase tracking-wider" for="name">{t('contact.form.name')}</label>
            <input
              autocomplete="name"
              class="w-full px-6 py-4 rounded-2xl bg-surface/50 border border-primary/10 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-text-main"
              id="name"
              name="name"
              required
              type="text"
            />
          </div>
          <div class="space-y-2">
            <label class="text-sm font-bold text-text-main ml-1 uppercase tracking-wider" for="email">{t('contact.form.email')}</label>
            <input
              autocomplete="email"
              class="w-full px-6 py-4 rounded-2xl bg-surface/50 border border-primary/10 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-text-main"
              id="email"
              name="email"
              required
              type="email"
            />
          </div>
        </div>
        
        <div class="space-y-2">
          <label class="text-sm font-bold text-text-main ml-1 uppercase tracking-wider" for="subject">{t('contact.form.subject')}</label>
          <input
            class="w-full px-6 py-4 rounded-2xl bg-surface/50 border border-primary/10 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-text-main"
            id="subject"
            name="subject"
            required
            type="text"
          />
        </div>

        <div class="space-y-2">
          <label class="text-sm font-bold text-text-main ml-1 uppercase tracking-wider" for="message">{t('contact.form.message')}</label>
          <textarea
            class="w-full px-6 py-4 rounded-2xl bg-surface/50 border border-primary/10 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-text-main min-h-[150px]"
            id="message"
            name="message"
            required
            rows="5"></textarea>
        </div>

        <div class="flex justify-center pt-4">
          <Button text={t('contact.form.btn')} variant="primary" type="submit" />
        </div>
      </form>
    </div>
  </div>
</section>
