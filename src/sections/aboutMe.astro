---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import InfoCard from "@/components/About/InfoCard.astro";
import Journey from "@/components/About/Journey.astro";
import Badge from "@/components/Badge.astro";
import { tecnologies } from "@/consts/tecnologies";


const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const aboutCards = t('about.cards') as Array<{ title: string; desc: string }>;
const timeline = t('about.timeline') as Array<{ year: string; label: string }>;

const icons = ["🚀", "🌍", "📚"];
---

<section id="nav.about" class="relative overflow-hidden py-24 lg:py-32 bg-surface/50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-16 lg:grid-cols-12 items-center">
      
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-4 py-1.5 text-sm font-medium text-primary border border-primary/20 mb-6">
          <span class="relative flex h-2 w-2">
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
          </span>
          {t('about.imageSubtitle')}
        </div>
        
        <h2 class="text-4xl font-black tracking-tight text-text-main sm:text-6xl mb-8">
          {t('about.title')} 
          <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">
            {t('about.titleGradient')}
          </span>
        </h2>
        
        <p class="text-xl leading-relaxed text-text-muted max-w-2xl">
          {t('about.description')}
        </p>

        <div class="mt-12">
           <Journey items={timeline} />
        </div>
      </div>

      <!-- Right Column: Bento Cards -->
      <div class="lg:col-span-5 grid grid-cols-1 gap-6">
        {aboutCards.map((card, index) => (
          <InfoCard 
            title={card.title} 
            description={card.desc} 
            icon={icons[index]} 
          />
        ))}
      </div>
    </div>

    <!-- Skills Summary -->
    <div class="mt-32 p-8 lg:p-12 rounded-[2.5rem] bg-surface border border-primary/10 shadow-xl">
       <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h3 class="text-3xl font-bold text-text-main mb-6 flex items-center gap-3">
              <span class="h-10 w-1.5 bg-primary rounded-full"></span>
              {t('nav.skills')}
            </h3>
            <p class="text-lg text-text-muted mb-8">
               Domino las herramientas más potentes del ecosistema moderno para crear productos digitales que destacan.
            </p>
            <div class="flex flex-wrap gap-3">
              {tecnologies.map(({ name }) => (
                <Badge text={name} variant="glass" Class="hover:scale-110 hover:bg-primary/20 transition-all duration-300" />
              ))}
            </div>
          </div>
          
          <div class="relative group">
            <div class="absolute -inset-4 bg-primary/20 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="relative p-8 rounded-3xl bg-primary/10 border border-primary/20">
               <h4 class="text-xl font-bold text-text-main mb-4">Intereses & Enfoque</h4>
               <p class="text-text-muted leading-relaxed">
                 Exploro constantemente nuevas tecnologías, contribuyo al código abierto y disfruto de la fotografía y el senderismo en mi tiempo libre. Mi objetivo siempre es la excelencia técnica.
               </p>
            </div>
          </div>

          
       </div>
    </div>
  </div>

</section>

