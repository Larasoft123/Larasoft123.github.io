---
import Badge from "@/components/Badge.astro";
import { tecnologies } from "@/consts/tecnologies";
import Experience from "@/components/Experience.astro";
import Education from "@/components/Education.astro";
---

<section class="w-full flex-1">
  <header
    class="py-20 text-white"
    style="background-image: url('image-e41c4d9241514781b0a8809a4731f821');"
  >
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div
        class="flex flex-col items-center gap-8 bg-black/50 p-8 rounded-xl backdrop-blur-sm"
      >
        <div
          class="size-32 rounded-full bg-cover bg-center"
          style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuA1aAfvWmu2jc_riQFr4QBuPPla2e0-aS47px_QBWC1aLaIp3gTNI2TI3LdXM-yNjA7aKjAo8E0ghSi-QZfFgFxEzMWajxxc6he5wE3IM0QnVKZmdADF84RMXiU6hO_KHPPO_43Obpte865RA5oEhKm3a1YwYzRNWCDtKIIa0iIEuSrCy4AXqah-dfA0FHq2z6iBpaUrsl87J3G8NUT00tbqkHFDpDkgiuip1eDtq5CIYPt-vhR525Xtjvq6YQ4Et7NpuW7vyLj1b76");'
        >
        </div>
        <div class="text-center">
          <h1 class="text-3xl font-bold text-white">Alejandro Ramirez</h1>
          <p class="mt-1 text-lg text-white/80">
            Desarrollador Fullstack Especializado en Front-end
          </p>
        </div>
      </div>
    </div>
  </header>
  <footer class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mt-16 grid grid-cols-1 gap-16 md:grid-cols-3">
      <div class="md:col-span-2">
        <Experience />
        <Education />
      </div>

      <div class="space-y-8">
        <section>
          <h2 class="text-2xl font-bold text-white">Habilidades</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {tecnologies.map(({ name }) => <Badge text={name} />)}
          </div>
        </section>
        <section>
          <h2 class="text-2xl font-bold text-white">Intereses</h2>
          <p class="mt-4 text-white/80">
            En mi tiempo libre, disfruto explorar nuevas tecnologías, contribuir
            a proyectos de código abierto y participar en comunidades de
            desarrollo. También me apasiona la fotografía y el senderismo.
          </p>
        </section>
      </div>
    </div>
  </footer>
</section>
