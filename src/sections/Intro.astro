---
import Button from "@/components/Button.astro";
import { Github, Linkedin, Twitter, Mail } from "@lucide/astro";
import { Image } from "astro:assets";
import profileImage from "@/assets/img/Moises.jpg";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import ShortAbout from "@/components/About/shortAbout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const name = t("presentation.name");
const title = t("presentation.title");
const description = t("presentation.description");
const email = t("presentation.email");
const github = t("presentation.github");
const linkedin = t("presentation.linkedin");
const twitter = t("presentation.twitter");
---

<section
  id="nav.home"
  class="relative min-h-screen flex items-center overflow-hidden pt-28 lg:py-32"
>
  <div class="container mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
      <!-- Text & Content Column -->
      <div class="lg:col-span-7 space-y-10">
        <div class="space-y-4">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-bold uppercase tracking-widest"
          >
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
              ></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"
              ></span>
            </span>
            {t("hero.badge")}
          </div>

          <h1
            class="text-6xl md:text-8xl lg:text-9xl font-black text-text-main leading-[0.9] tracking-tighter font-display"
          >
            {t("presentation.name")}
            <span class="block text-primary drop-shadow-[0_0_30px_rgba(var(--primary-rgb),0.3)]"
              >{t("presentation.title")}</span
            >
          </h1>

          <p
            class="text-xl md:text-2xl text-text-muted max-w-2xl leading-relaxed italic border-l-2 border-primary/30 pl-6"
          >
            "{t("presentation.phrase")}"
          </p>
        </div>

        <ShortAbout />
        <!-- Call to Actions & Socials -->
        <div class="flex flex-col sm:flex-row items-center gap-8">
          <div class="flex gap-4">
            <Button
              variant="primary"
              text={t("nav.projects")}
              isLink
              href="#nav.projects"
            />
            <Button
              variant="outline"
              text={t("nav.contact")}
              isLink
              href="#nav.contact"
            />
          </div>

          <div class="flex items-center gap-5">
            <a
              rel="noopener noreferrer"
              href={github}
              target="_blank"
              aria-label="GitHub"
              class="text-text-muted hover:text-primary transition-all hover:scale-125"
            >
              <Github class="size-6" aria-hidden="true" />
            </a>
            <a
              rel="noopener noreferrer"
              href={linkedin}
              target="_blank"
              aria-label="LinkedIn"
              class="text-text-muted hover:text-primary transition-all hover:scale-125"
            >
              <Linkedin class="size-6" aria-hidden="true" />
            </a>
            <a
              rel="noopener noreferrer"
              href={twitter}
              target="_blank"
              aria-label="Twitter"
              class="text-text-muted hover:text-primary transition-all hover:scale-125"
            >
              <Twitter class="size-6" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>

      <!-- Image & Decorative Phrase Column -->
      <div class="lg:col-span-12 xl:col-span-5 relative">
        <div class="relative group mx-auto max-w-sm lg:max-w-none">
          <!-- Background Decoration -->
          <div class="absolute -top-12 -right-12 text-[15rem] font-bold text-primary/5 select-none font-display pointer-events-none hidden xl:block">
            {t("presentation.name").split(' ')[0]}
          </div>

          <!-- Background Glow -->
          <div
            class="absolute -inset-10 bg-gradient-to-tr from-primary/30 via-secondary/20 to-accent/30 blur-3xl group-hover:opacity-60 transition-opacity duration-700"
          >
          </div>

          <!-- Image Container -->
          <div
            class="relative aspect-[4/5] rounded-[2rem] border border-white/10 shadow-2xl overflow-hidden group rotate-2 hover:rotate-0 transition-transform duration-500"
          >
            <Image
              src={profileImage}
              alt={name}
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
