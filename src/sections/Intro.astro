---
import Container from "../components/container.astro";

import AboutMe from "@/sections/aboutMe.astro";
import Badge from "@/components/Badge.astro";
import ContentIntro from "@/components/ContentIntro.astro";
---

<Container
  className="mt-40 flex flex-col items-center justify-center "
  id="Intro"
>
  <ContentIntro />
  <AboutMe />

  <Badge isDark={true} Class="mt-12 mb-8"
    >
    <button>
      <label
        for="controler-checkbox"
        class="inline-flex text-center justify-center flex-col items-center cursor-pointer"
      >
        <span id="text-content">Ver mas</span>
      </label>
    </button>
  </Badge>
  <input type="checkbox" id="controler-checkbox" class="peer hidden" />
</Container>

<script>
  document.addEventListener("astro:page-load", () => {
    // elementos del DOM
    const CrtlCheckbox = document.getElementById(
      "controler-checkbox"
    ) as HTMLInputElement;
    const AboutSection = document.getElementById("AboutMe") as HTMLElement;
    const introContent = document.getElementById(
      "intro-content"
    ) as HTMLElement;
    const textContent = document.getElementById(
      "text-content"
    ) as HTMLButtonElement;

    CrtlCheckbox?.addEventListener("change", (event) => {
      const target = event.target as HTMLInputElement;
      if (target.checked) {
        AboutSection?.classList.remove("hidden");
        introContent?.classList.add("hidden");
        AboutSection?.classList.add("block");
        textContent.innerHTML = "Ver menos";
        return;
      }

      AboutSection?.classList.remove("block");
      introContent?.classList.remove("hidden");
      introContent?.classList.add("block");
      AboutSection?.classList.add("hidden");
      textContent.innerHTML = "Ver más";
    });
  });
</script>
