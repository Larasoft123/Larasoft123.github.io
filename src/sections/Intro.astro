---
import Button from "@/components/Button.astro";
import Galaxy from "@/components/Galaxy";
---

<section class="relative">
  <div class="absolute inset-0">
    <!-- <Galaxy client:idle mouseRepulsion={false} density={0.4} saturation={1} /> -->
  </div>

  <div class="absolute inset-0 bg-black/60"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-32 md:py-48">
    <div class="text-center">
      <h1
        class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl md:text-6xl animate-slide-in-left"
      >
        Hi, I'm Alex Ramirez
      </h1>
      <p
        class="mt-3 max-w-md mx-auto text-base text-gray-300 sm:text-lg md:mt-5 md:text-xl md:max-w-3xl animate-slide-in-right"
        style="animation-delay: 0.3s;"
      >
        Full-stack developer specializing in front-end development. Passionate
        about creating intuitive and engaging user experiences.
      </p>
      <div
        class="mt-5 max-w-md mx-auto sm:flex sm:justify-center md:mt-8 animate-fade-in"
        style="animation-delay: 0.8s;"
      >
        <div class="rounded-lg shadow">
          <Button
            text="View Projects"
            class="w-full px-8 py-3 text-base font-medium rounded-lg md:py-4 md:text-lg md:px-10"
          />
        </div>
      </div>
    </div>
  </div>
</section>
