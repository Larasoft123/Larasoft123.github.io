---
import { ProyectsList } from "@/consts/Proyects";
import ProyectCard from "@/components/ProyectCard.astro";
import Button from "@/components/Button.astro";
---

<section class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <h1 class="text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4">
        Mis Proyectos
      </h1>
      <p class="text-lg text-gray-400">
        Una colección de proyectos que destacan mis habilidades en desarrollo
        web, desde aplicaciones interactivas hasta sitios web responsivos.
      </p>
    </div>
    <div class="flex flex-col md:flex-row gap-8 mb-12">
      <div class="flex flex-wrap items-center gap-4">
        <span class="text-sm font-medium text-gray-400"
          >Filtrar por tecnología:</span
        >
        <button
          class="px-4 py-2 text-sm font-medium text-white bg-primary rounded-full"
          >Todos</button
        >
        <Button text="React" variant="badge" />
        <Button text="Angular" variant="badge" />
        <Button text="Vue" variant="badge" />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <div
        class="group relative bg-gray-800/20 rounded-xl overflow-hidden shadow-lg transition-all duration-500 ease-in-out h-64 hover:h-96"
      >
        <div
          class="w-full h-full bg-center bg-no-repeat bg-cover absolute inset-0 transition-all duration-500 ease-in-out group-hover:scale-110"
          style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBYyrF0BJK9a_yJ18itAbON26sfv1TU0auVjAg4ibCrfAMclhTXytk6LScJcs9BGUqjOmjECO8WEJJEcwGjTTF6S2OOQqoEPqK_ox15yQDdvdtvTMvpmV2TX_exI6OdguKv-G_wh6Pdcg__o7lJ0MRCYnXeHGNjvVqL73HMifiJAXjLcLxegjcJCaER6BJo21MWY0Z0-jpLFvHwo3IXdUv_zzR0qYb9dx8t4j077RMztZEPGIcc49VpAHHQ2IygXrN-ogVOGvb9vga0");'
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"
        >
        </div>
        <div
          class="absolute bottom-0 left-0 right-0 p-6 text-white transition-all duration-500 ease-in-out"
        >
          <h3 class="text-xl font-bold mb-2">Aplicación de Finanzas</h3>
          <p
            class="text-gray-300 text-sm max-h-0 opacity-0 group-hover:max-h-40 group-hover:opacity-100 transition-all duration-500 ease-in-out mb-4"
          >
            Una aplicación web completa para gestionar finanzas personales, con
            seguimiento de gastos, creación de presupuestos y visualizaciones de
            datos interactivas para una mejor comprensión financiera.
          </p>
          <div
            class="flex gap-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-200"
          >
            <a
              class="px-4 py-2 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary/90 transition-colors"
              href="#">Ver Proyecto</a
            >
            <a
              class="px-4 py-2 text-sm font-semibold text-white bg-gray-600/70 rounded-lg hover:bg-gray-600/90 transition-colors"
              href="#">Ver Código</a
            >
          </div>
        </div>
      </div>

      {
        ProyectsList.map(
          ({ description, github, image, link, name, tags, date }, index) => (
            <ProyectCard
              tags={tags}
              image={image}
              name={name}
              animationClass={``}
              description={description}
              date={date}
            />
          )
        )
      }
    </div>
  </div>
</section>
