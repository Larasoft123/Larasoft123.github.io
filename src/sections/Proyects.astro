---
import { ProyectsList } from "@/consts/Proyects";
import ProyectCard from "@/components/ProyectCard.astro";
import Button from "@/components/Button.astro";
import SpotlightEffect from "@/components/SpotlightEffect.astro";
---

<section id="nav.projects" class="container mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <h1 class="text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4">
        Mis Proyectos
      </h1>
      <p class="text-lg text-gray-400">
        Una colección de proyectos que destacan mis habilidades en desarrollo
        web, desde aplicaciones interactivas hasta sitios web responsivos.
      </p>
    </div>
    <div class="flex flex-col md:flex-row gap-8 mb-12">
      <div class="flex flex-wrap items-center gap-4">
        <span class="text-sm font-medium text-gray-400"
          >Filtrar por tecnología:</span
        >
        <button
          class="px-4 py-2 text-sm font-medium text-white bg-primary rounded-full"
          >Todos</button
        >
        <Button text="React" variant="outline" />
        <Button text="Angular" variant="outline" />
        <Button text="Vue" variant="outline" />
      </div>
    </div>

    <SpotlightEffect class="mb-20">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          ProyectsList.map(
            ({ description, github, image, link, tags, title }, index) => (
              <ProyectCard
                tags={tags}
                image={image}
                title={title}
                description={description}
              />
            )
          )
        }
      </div>

      <div
        slot="overlay"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8"
      >
        {
          ProyectsList.map(
            ({ description, github, image, link, tags, title }, index) => (
              <ProyectCard
                tags={tags}
                image={image}
                title={title}
                description={description}
                isOverlay={true}
              />
            )
          )
        }
      </div>
    </SpotlightEffect>
  </div>
</section>
