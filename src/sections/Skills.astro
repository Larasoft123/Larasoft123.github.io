---
import { tecnologies } from "../consts/tecnologies";
import Badge from "@/components/Badge.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import InfoCard from "@/components/About/InfoCard.astro";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface SkillItem {
  title: string;
  desc: string;
}

const skillsList = t('skills.list')  as SkillItem[];
const coreTechnologies = t('skills.coreTechnologies') as string;
---

<section id="nav.skills" class="py-24 lg:py-32 relative overflow-hidden bg-surface/30">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
         <h2 class="text-4xl font-black tracking-tighter text-text-main sm:text-7xl mb-8 font-display uppercase italic">
            {t('skills.title')}
         </h2>
         <p class="text-xl text-text-muted mb-12 border-l-2 border-primary/20 pl-6">
            {t('skills.subtitle')}
         </p>
         
         <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 relative">
            {skillsList.map((item, index) => (
              <div 
                class={`p-8 rounded-[2rem] bg-surface/50 backdrop-blur-sm border border-primary/10 shadow-xl group hover:border-primary/40 transition-all duration-500 hover:-translate-y-2 ${index % 2 !== 0 ? 'sm:translate-y-8' : ''}`}
              >
                <div class="size-12 rounded-2xl bg-primary/10 flex items-center justify-center mb-6 text-primary group-hover:bg-primary group-hover:text-white transition-colors duration-500">
                  <span class="text-xl font-black">{index + 1}</span>
                </div>
                <h3 class="text-xl font-black text-text-main mb-3 group-hover:text-primary transition-colors font-display tracking-tight">{item.title}</h3>
                <p class="text-base text-text-muted leading-relaxed">{item.desc}</p>
              </div>
            ))}
         </div>
      </div>
      
      <div class="relative">
         <div class="absolute inset-0 bg-primary/20 blur-[100px] rounded-full animate-blob"></div>
         <div class="relative glass-panel p-10 rounded-[3rem] border border-primary/20 shadow-2xl">
            <h3 class="text-2xl font-bold text-text-main mb-8 flex items-center gap-3">
              <span class="h-8 w-1.5 bg-primary rounded-full"></span>
              {coreTechnologies}
            </h3>
            <div class="flex flex-wrap gap-4">
              {tecnologies.map(({ name }) => (
                <Badge text={name} variant="glass" Class="hover:scale-110 hover:bg-primary/20 transition-all duration-300 text-sm font-bold px-4 py-2" />
              ))}
            </div>



            <InfoCard
              title={t('skills.sideTitle')}
              description={t('skills.sideDesc')}
              className="mt-12"     
            />

         </div>
      </div>
    </div>
  </div>
</section>
