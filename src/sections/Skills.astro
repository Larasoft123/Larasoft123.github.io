---
import Container from "../components/container.astro";
import { tecnologies } from "../consts/tecnologies";
import SkillCard from "@/components/SkillCard.astro";
import TextSection from "@/components/TextSection.astro";
---

<Container className="" id="skills">
  <TextSection name="Skills" className="text-amber-400 entry-animation  ">
    <div slot="content" class="grid grid-cols-9 gap-y-4 gap-x-2 mt-20 lg:mt-5">
      <div
        id="container-skillCards"
        class="grid grid-cols-4 md:grid-cols-6 xl:grid-cols-8 mt-8 gap-14 relative mx-auto justify-center p-1 items-center lg:mt-14 col-span-full"
      >
        {
          tecnologies.map(({ image, name }) => (
            <SkillCard image={image} name={name} />
          ))
        }
      </div>
    </div>
  </TextSection>
</Container>

