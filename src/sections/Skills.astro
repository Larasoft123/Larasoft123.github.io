---
import Container from "../components/container.astro";
import { tecnologies } from "../consts/tecnologies";
import SkillCard from "@/components/SkillCard.astro";
---

<Container className="" id="skills">
  <article class="flex flex-col gap-4 text-white">
    <h1 class="text-center text-3xl font-bold mt-16">Skills</h1>

    <div class="grid grid-cols-9 gap-y-4 gap-x-2 mt-20 lg:mt-5">
      <div
        id="container-skillCards"
        class="grid grid-cols-4 md:grid-cols-6 xl:grid-cols-8 mt-8 gap-14 relative mx-auto justify-center p-1 items-center lg:mt-14 col-span-full"
      >
        {
          tecnologies.map(({ image, name }) => (
            <SkillCard image={image} name={name} />
          ))
        }

        <div
          id="selectorFighter"
          class="absolute w-[var(--selector--width)] h-[var(--selector--height)] top-[var(--selector--top)] left-[var(--selector--left)] duration-500 ease-[cubic-bezier(0.4,0,0.2,1)] transition-all opacity-0 z-40 pointer-events-none"
        >
        </div>
      </div>
    </div>
  </article>
</Container>

