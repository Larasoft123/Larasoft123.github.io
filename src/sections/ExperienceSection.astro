---
import Experience from "@/components/Experience.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="nav.experience" class="py-24 lg:py-32 relative overflow-hidden">
  <div class="absolute top-1/2 left-0 -z-10 w-96 h-96 bg-primary/5 blur-[100px] rounded-full"></div>
  
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
       <h2 class="text-4xl font-black tracking-tight text-text-main sm:text-6xl mb-8">
          {t("experience.title")} <span class="text-primary">{t("experience.titleHighlight")}</span>
       </h2>
       <p class="text-xl text-text-muted mb-16">
          {t("experience.description")}
       </p>
    </div>

    <div class="rounded-3xl bg-surface border border-primary/10 p-8 md:p-12 shadow-2xl relative overflow-hidden">
        
        <Experience />
    </div>
  </div>
</section>
