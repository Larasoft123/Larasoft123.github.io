---
import TimelineItem from "./TimelineItem.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import type { ExperienceItem } from "@/types/types";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const experienceData = t("experience.list") as ExperienceItem[];
---

<div>
  <h3 class="text-3xl font-bold text-white mb-10 flex items-center gap-4">
    <span class="p-2 bg-primary/20 rounded-lg">💼</span>
    {t("experience.sectionTitle")}
  </h3>
  
  <ol class="relative border-s border-white/10 ml-3">
    {experienceData.map((item) => (
      <TimelineItem {...item} />
    ))}
  </ol>
</div>

