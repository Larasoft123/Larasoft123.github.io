---
interface Props{
  name: string,
  url: string,
  image: {
    logo: any,
    width: number,
    height: number,
    className?: string
  }
}

const { image, name, url } = Astro.props;

---




<a
  class={`flex group logo flex-col items-center mx-5 p-1 justify-center ${image.className}`}
  data-id={name}
  href={url}
  rel="noopener noreferrer"
  target="_blank"
>
  <image.logo
    class={`h-14 logito w-auto group-hover:scale-105 group-hover:-translate-y-1 transition-all`}
    width={image.width}
    height={image.height}
    alt={name}
  />
</a>


<style>
    a {
      cursor: pointer;
    }

    .logito{



      filter: grayscale(.2);
      &:hover{
        filter: drop-shadow(0px 0px 10px #ffffffaa);
       
      }
    }

    

    
  </style>