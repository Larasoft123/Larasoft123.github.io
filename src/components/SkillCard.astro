---
interface Props{
  name: string,
  image: {
    logo: any,
    width: number,
    height: number,
    className: string
  }
}

const { image, name } = Astro.props;


---




<a
  class={`flex group relative z-10 logo flex-col items-center p-1 justify-center ${image.className}`}
  data-id={name}
  

>
  <image.logo
    className={`h-auto relative z-30 logito not-first:group-hover:scale-105 group-hover:-translate-y-1 transition-all ${image.className}`}
    width={image.width}
    height={image.height}
    alt={name}
  />
</a>


<style>
    a {
      cursor: pointer;
    }

    .logo{
      filter: grayscale(.2);

      .logito{
        cursor: pointer;
      }
      &:hover{
        filter: drop-shadow(0px 0px 10px #ffffffaa);
       
      }
    }

    

    
  </style>