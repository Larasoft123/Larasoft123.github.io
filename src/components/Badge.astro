---
interface Props {
  Class?: string;
  text: string;
  variant?: "default" | "outline" | "glass";
}

const { Class: className = "", text, variant = "default" } = Astro.props;

const variants = {
  default: "bg-primary/20 text-primary border border-primary/20",
  outline: "bg-transparent text-gray-300 border border-white/20",
  glass: "bg-white/5 text-white backdrop-blur-sm border border-white/10",
};
---

<span
  class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-medium transition-colors cursor-default ${variants[variant]} ${className}`}
>
  {text}
</span>
