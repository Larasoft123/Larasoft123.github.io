---
interface Props {
  class?: string;
  isHoverable?: boolean;
}

const { class: className = "", isHoverable = false } = Astro.props;
---

<div
  class={`
    relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-md transition-all duration-300
    ${isHoverable ? "hover:bg-white/10 hover:shadow-xl hover:shadow-primary/5 hover:-translate-y-1" : ""}
    ${className}
  `}
>
  <slot />
</div>
