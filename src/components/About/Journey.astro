---
interface Props {
  items: Array<{ year: string; label: string }>;
}

const { items } = Astro.props;
---

<div class="relative py-10">
  <!-- Horizontal Line -->
  <div class="absolute left-0 top-[4.5rem] h-0.5 w-full bg-white/10"></div>
  
  <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
    {items.map((item, index) => (
      <div class={`relative flex flex-col items-center ${index % 2 === 0 ? 'md:pt-0' : 'md:pt-12'}`}>
        
        <div class="absolute left-1/2 top-8 z-10 size-4 -translate-x-1/2 rounded-full border-4 border-gray-900 bg-primary shadow-[0_0_15px_rgba(var(--primary-rgb),0.5)]"></div>
        
        <div class="text-center">
          <span class="block text-2xl font-black text-white/20 transition-all hover:text-primary/40">{item.year}</span>
          <p class="mt-4 text-sm font-medium text-gray-400 max-w-[120px] mx-auto truncate" title={item.label}>{item.label}</p>
        </div>
      </div>
    ))}
  </div>
</div>
