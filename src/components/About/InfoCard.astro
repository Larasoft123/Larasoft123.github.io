---
interface Props {
  title: string;
  description: string;
  className?: string;
  icon?: string;
}

const { title, description, icon, className } = Astro.props;
---

<div class={`group relative overflow-hidden rounded-2xl bg-white/5 p-6 transition-all hover:bg-white/10 hover:shadow-2xl hover:shadow-primary/10 border border-white/10 ${className}`}>
  <div class="absolute -right-4 -top-4 size-24 rounded-full bg-primary/10 blur-2xl transition-all group-hover:bg-primary/20"></div>
  
  <div class="relative z-10">
    <div class={`mb-4 flex size-10 items-center justify-center rounded-lg bg-primary/20 text-primary ${!icon ? 'hidden' : ''}`} >
      {icon ? <span class="text-xl">{icon}</span> : null}
    </div>
    <h3 class="mb-2 text-xl font-bold text-white group-hover:text-primary transition-colors">{title}</h3>
    <p class="text-sm leading-relaxed text-gray-400 group-hover:text-gray-300 transition-colors">
      {description}
    </p>
  </div>
</div>
