---
import { type Certification } from "@/types/types";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import IssuerIcon from "@/components/Certification/IssuerIcon.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const viewCredential = t("certifications.viewCredential");

interface Props extends Certification {}

const { date, issuer, link, name, shortIssuer } = Astro.props;
---

<a
  rel="noopener noreferrer"
  href={link}
  target="_blank"
  class="group relative p-8 rounded-[2rem] bg-surface border border-primary/10 hover:border-primary/30 transition-all duration-500 shadow-lg hover:shadow-2xl hover:-translate-y-2"
>
  <div class="flex items-start justify-between mb-6">
    <div
      class="size-16 rounded-2xl flex items-center justify-center bg-primary/5 p-3 group-hover:bg-primary/10 transition-colors"
    >
      <IssuerIcon shortIssuer={shortIssuer} />
    </div>
    <span class="text-sm font-bold text-primary/90">{date}</span>
  </div>

  <h3
    class="text-xl font-bold text-text-main mb-2 group-hover:text-primary transition-colors"
  >
    {name}
  </h3>
  <p class="text-text-muted text-sm font-medium">{issuer}</p>

  <div
    class="mt-6 flex items-center text-primary text-sm font-bold opacity-0 group-hover:opacity-100 transition-opacity"
  >
    {viewCredential}
    <svg
      fill="none"
      stroke="currentColor"
      class="w-4 h-4 ml-2"
      viewBox="0 0 24 24"
      ><path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="m17 8 4 4m0 0-4 4m4-4H3"></path></svg
    >
  </div>
</a>
