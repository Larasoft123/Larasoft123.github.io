---
import { languages } from "@/i18n/ui";
import { getRouteFromUrl, useTranslatedPath } from "@/i18n/utils";
import { type Language } from "@/types/types";

const route = getRouteFromUrl(Astro.url);
const currentLang = Astro.currentLocale || "es";
---

<div class="relative group" id="language-picker">
  <button
    id="i18n-btn"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="i18n-list"
    aria-label={`Seleccionar idioma (Actual: ${currentLang.toUpperCase()})`}
    class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/10 hover:border-primary/50 bg-white/5 hover:bg-white/10 transition-all text-xs font-semibold tracking-wide group-hover:text-white text-gray-300 focus:outline-none focus:ring-2 focus:ring-primary/50"
  >
    <svg
      id="i18n-icon"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="w-3.5 h-3.5 group-hover:rotate-180 transition-transform duration-500"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path
        d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
      ></path>
    </svg>

    {currentLang.toUpperCase()}
  </button>

  <ul
    id="i18n-list"
    role="menu"
    class="absolute right-0 top-full mt-2 w-32 origin-top-right rounded-lg bg-surface border border-white/10 shadow-lg backdrop-blur-xl opacity-0 scale-95 invisible group-hover:opacity-100 group-hover:scale-100 group-hover:visible transition-all duration-200 z-50 p-1"
  >
    {
      Object.entries(languages).map(([lang, label]) => {
        const translatePath = useTranslatedPath(lang as Language);
        const isActive = currentLang === lang;
        return (
          <li role="none">
            <a
              href={translatePath(`/${route ? route : ""}`)}
              role="menuitem"
              aria-current={isActive ? "page" : undefined}
              class={`flex items-center w-full px-3 py-2 text-sm rounded-md transition-colors ${
                isActive
                  ? "bg-primary/10 text-primary font-medium"
                  : "text-text-muted hover:bg-white/5 hover:text-white"
              } focus:outline-none focus:bg-white/10`}
            >
              {label}
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  function initLanguagePicker() {
    const container = document.getElementById('language-picker');
    const btn = document.getElementById('i18n-btn');
    const list = document.getElementById('i18n-list');
    const icon = document.getElementById('i18n-icon');
    const items = list?.querySelectorAll('a');

    if (!container || !btn || !list || !icon) return;

    let isLocked = false;

    const toggleMenu = (isOpen = !isLocked) => {
      isLocked = isOpen;
      
      const showClasses = ['opacity-100', 'scale-100', 'visible'];
      const hideClasses = ['opacity-0', 'scale-95', 'invisible'];

      showClasses.forEach(cls => list.classList.toggle(cls, isLocked));
      hideClasses.forEach(cls => list.classList.toggle(cls, !isLocked));
      
      icon.classList.toggle('rotate-180', isLocked);
      btn.setAttribute('aria-expanded', String(isLocked));
    };



    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      toggleMenu();
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!container.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    // Handle focus out (for tabbing away)
    container.addEventListener('focusout', (e) => {
      if (e.relatedTarget && !container.contains(e.relatedTarget as Node)) {
        toggleMenu();
      }
    });

    // Keyboard navigation
    container.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleMenu();
        btn.focus();
      }

      if (btn.getAttribute('aria-expanded') === 'true' && items) {
        const itemArray = Array.from(items);
        const currentIndex = itemArray.indexOf(document.activeElement as HTMLAnchorElement);

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          const nextIndex = (currentIndex + 1) % itemArray.length;
          itemArray[nextIndex].focus();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          const prevIndex = (currentIndex - 1 + itemArray.length) % itemArray.length;
          itemArray[prevIndex].focus();
        }
      }
    });

    // Handle mouse events to sync locked state
    container.addEventListener('mouseenter', () => {
      if (!isLocked) {
        btn.setAttribute('aria-expanded', 'true');
      }
    });

    container.addEventListener('mouseleave', () => {
      if (!isLocked) {
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Support Astro View Transitions
  document.addEventListener('astro:page-load', initLanguagePicker);
</script>
