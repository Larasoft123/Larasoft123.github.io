---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import type { ExperienceItem } from "@/types/types";


interface Props extends ExperienceItem {
    
}

const { description, timeData, title, latest } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<li class="relative ml-6 pb-12 last:pb-0">
  
  <div
    class="absolute -left-[29px] top-2 h-full w-[2px] bg-primary/20 last:hidden"
  >
  </div>
 
  <span
    class="absolute -left-9 flex h-4 w-4 items-center justify-center rounded-full bg-primary ring-4 ring-background"
  >
  </span>
 
  <div class="group relative transition-all duration-300">
    <h4
      class="flex items-center text-lg font-bold text-text-main group-hover:text-primary transition-colors"
    >
      {title}
      {
        latest && (
          <span class="ml-3 rounded-md bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary border border-primary/20">
            {t("experience.latestLabel")}
          </span>
        )
      }
    </h4>

    <time class="my-2 block text-sm font-medium leading-none text-text-muted opacity-80"
      >{timeData}</time
    >
    <p
      class="mb-4 text-base font-normal text-text-muted leading-relaxed max-w-[80%]"
    >
      {description}
    </p>
  </div>
</li>
