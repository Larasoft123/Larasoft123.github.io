---
import { Github, ExternalLink } from "@lucide/astro";
import { type Project } from "@/types/types";

interface Props extends Project {
  isOverlay?: boolean;
}

const {
  title,
  image,
  github,
  description,
  tags,
  link,
  isOverlay = false,
} = Astro.props;
---

<article
  class:list={[
    "relative rounded-2xl overflow-hidden border transition-all duration-500 h-full",
    isOverlay
      ? "bg-gradient-to-br from-indigo-900/40 via-purple-900/40 to-slate-900/80 border-indigo-400/80 shadow-[0_0_30px_0_rgba(99,102,241,0.3)] z-10"
      : "bg-slate-900 border-slate-800",
  ]}
>
  <div class="aspect-video overflow-hidden">
    <img src={image} alt={title} class="w-full h-full object-cover" />
  </div>

  <div class="p-6">
    <div class="flex justify-between items-start mb-4">
      <h3
        class:list={[
          "text-xl font-bold transition-colors",
          isOverlay
            ? "text-transparent bg-clip-text bg-gradient-to-r from-indigo-300 via-purple-300 to-cyan-300 drop-shadow-sm"
            : "text-white",
        ]}
      >
        {title}
      </h3>
      <div
        class:list={[
          "flex space-x-2",
          isOverlay && "opacity-0 pointer-events-none",
        ]}
      >
        <a
          rel="noopener noreferrer"
          href={github}
          target="_blank"
          class="text-slate-400 cursor-pointer z-100 hover:text-white transition-colors"
          aria-label={`View code for ${title} on GitHub`}
          tabindex={isOverlay ? "-1" : undefined}
          aria-hidden={isOverlay ? "true" : undefined}
        >
          <Github size={18} class="hover:scale-125 hover:text-primary" aria-hidden="true" />
        </a>

        <a
          rel="noopener noreferrer"
          href={link}
          target="_blank"
          class="text-slate-400 cursor-pointer z-100 hover:text-white transition-colors"
          aria-label={`Visit live demo for ${title}`}
          tabindex={isOverlay ? "-1" : undefined}
          aria-hidden={isOverlay ? "true" : undefined}
        >
          <ExternalLink size={18} class="hover:scale-125 hover:text-primary" aria-hidden="true" />
        </a>
      </div>
    </div>

    <p class="text-slate-400 text-sm mb-6 line-clamp-3">
      {description}
    </p>

    <div class="flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <span class="px-2 py-1 text-xs font-medium rounded-md bg-slate-700/50 text-indigo-300 border border-slate-600">
            {tag.name}
          </span>
        ))
      }
    </div>
  </div>
</article>
