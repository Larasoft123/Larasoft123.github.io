---
import MenuBtn from "@/assets/icons/MenuBtn.astro";
import WhatsAppBtn from "./WhatsAppBtn.astro";

const URL = Astro.url.pathname;
const isHome = URL === "/";

const LinkstoSections = [
  {
    name: "Home",
    href: `${isHome ? " #Intro" : "/"}`,
    label: "Intro",
  },
  {
    name: "Projects",
    href: `${isHome ? " #projects" : "/#projects"}`,
    label: "projects",
  },
  {
    name: "Skills",
    href: `${isHome ? "#skills" : "/#skills"}`,
    label: "skills",
  },
  {
    name: "About",
    href: `${isHome ? "#AboutMe" : " /#AboutMe"}`,
    label: "AboutMe",
  },
];
---

<header
  class="items-center animate-blur-shadow-black z-100 bg-transparent flex fixed top-0 w-full justify-center py-4 px-8 text-white/80 border-gray-700"
>
  <div class="flex max-w-4xl w-full mx-auto px-4 justify-center items-center">
    <nav class="flex w-full items-center md:justify-center">
      <ul
        class="flex justify-between md:justify-center w-full items-center gap-4"
      >
        <button
          id="menuBtn"
          class="rounded-full md:hidden cursor-pointer hover:scale-110 transition"
        >
          <MenuBtn />
        </button>

        {
          LinkstoSections.map(({ name, href, label }) => (
            <li class="cursor-pointer hidden md:inline-block  transition-colors duration-150 hover:text-primary text-xl bg-transparent px-4 py-2 font-bold">
              <a href={href} class="link-header" aria-label={`${label}`}>
                {name}
              </a>
            </li>
          ))
        }

        <li
          class="cursor-pointer rounded-full w-7 h-7 md:hidden hover:scale-110  transition inline-block"
        >
          <WhatsAppBtn />
        </li>

      </ul>
    </nav>

    <dialog
      class="transition-(display) fixed bg-gray-800 z-50 size-full min-h-full max-w-full translate-x-0 transition-discrete duration-300 lg:hidden starting:-translate-x-full [&:not([open])]:-translate-x-full"
      id="mobile-menu"
      role="dialog"
      aria-modal="true"
    >
      <div class="z-10 overflow-y-auto px-6 py-10">
        <div class="flex items-center justify-between">
          <div class="flex flex-1">
            <button
              type="button"
              id="close-menu-button"
              class="-m-2.5 cursor-pointer p-2.5 text-white transition-all duration-300 ease-in will-change-transform hover:scale-150"
            >
              <span class="sr-only">Cerrar Menú</span>
              <svg
                class="size-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                aria-hidden="true"
                data-slot="icon"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 18 18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>

        <div class="mt-6 space-y-2">
          <ul class="flex flex-col gap-3 text-white">
            {
              LinkstoSections.map(({ name, href }) => (
                <li class="drop-shadow-2xl cursor-pointer transition-colors  -mx-3 hover:bg-black/35 duration-150 hover:text-primary  rounded-xl backdrop-blur-xl  px-4 py-2 font-bold">
                  <a href={href} class="link-header">
                    {name}
                  </a>
                </li>
              ))
            }
          </ul>

          <!-- <a
          href="/#info"
          class="hover:text-primary-light border-primary-light -mx-3 block rounded-lg px-3 py-2 text-base/7 font-semibold text-white hover:bg-white"
          >Info</a
         > -->
        </div>
      </div>
    </dialog>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const linksHeader = document.querySelectorAll("header nav a");

    const options = {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    };

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          linksHeader.forEach((item) => {
            const label = item.getAttribute("aria-label");

            if (label == entry.target.id) {
              item.classList.add("text-primary");
            } else {
              item.classList.remove("text-primary");
            }
          });
        }
      });
    };

    let observer = new IntersectionObserver(callback, options);

    sections.forEach((section) => {
      observer.observe(section);
    });

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>

<!-- menu -->
<script>
  document.addEventListener("astro:page-load", () => {
    const menuBtn = document.getElementById("menuBtn");

    const mobileMenu = document.getElementById(
      "mobile-menu"
    ) as HTMLDialogElement;
    const closeMenuBtn = document.getElementById("close-menu-button");

    closeMenuBtn?.addEventListener("click", () => {
      mobileMenu.close();
    });

    function toggleMenu() {
      mobileMenu.open ? mobileMenu.close() : mobileMenu.showModal();
    }

    menuBtn?.addEventListener("click", () => {
      toggleMenu();
    });
  });
</script>
