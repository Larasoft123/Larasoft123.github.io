---
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "@/i18n/utils";
import LanguagePicker from "@/components/i18N/languagePicker.astro";
import { type Language } from "@/types/types";
import { Code, Menu, X } from "@lucide/astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang as Language);

const navItems = [
  { key: "nav.home", href: "#nav.home" },
  { key: "nav.about", href: "#nav.about" },
  { key: "nav.projects", href: "#nav.projects" },
  { key: "nav.skills", href: "#nav.skills" },
  { key: "nav.certifications", href: "#nav.certifications" },
  { key: "nav.contact", href: "#nav.contact" },
];

const LinkstoSections = navItems.map((item) => ({
  // @ts-ignore
  name: t(item.key),
  href: item.href.startsWith("#") ? item.href : translatePath(item.href),
  label: item.key,
}));

const homeLink = lang === "es" ? "/" : `/${lang}/`;

const getHref = (href: string) => {
  if (href.startsWith("#")) return `${homeLink}${href}`;
  return href;
};
---

<header
  id="main-header"
  class="nav-animate flex flex-col items-center border border-transparent transition-all duration-300 z-50"
  role="banner"
>
  <div
    class="flex justify-between lg:grid lg:grid-cols-[1fr_auto_1fr] items-center w-full px-6 lg:px-8"
  >
    {/* Logo (Left) */}
    <div class="flex justify-start">
      <a
        href={homeLink}
        class="flex items-center gap-2 group cursor-pointer"
        aria-label="Larasoft Home"
      >
        <div
          class="p-2 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-xl border border-white/10 group-hover:border-primary/50 transition-colors"
        >
          <Code class="text-primary w-5 h-5" aria-hidden="true" />
        </div>
        <span
          class="hidden sm:block text-lg font-bold bg-clip-text text-transparent bg-gradient-to-r from-white to-white/70"
        >
          Larasoft
        </span>
      </a>
    </div>

    {/* Desktop Nav (Center) */}
    <nav
      class="hidden lg:flex justify-center items-center gap-1"
      aria-label="Desktop Navigation"
    >
      {
        LinkstoSections.map((item) => (
          <a
            href={getHref(item.href)}
            aria-label={item.label}
            class="nav-link px-5 py-2 text-sm font-medium text-text-muted hover:text-white transition-colors relative group"
          >
            {item.name}
            <span class="absolute inset-0 bg-white/5 rounded-full scale-90 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300" />
          </a>
        ))
      }
    </nav>

    {/* Actions (Right) */}
    <div class="flex justify-end items-center gap-3">
      <LanguagePicker />

      <button
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle Mobile Menu"
        class="lg:hidden text-text-main p-2 hover:bg-white/5 rounded-full transition-colors focus:ring-2 focus:ring-primary/50 focus:outline-none"
      >
        <Menu id="menu-icon" class="w-6 h-6 block" aria-hidden="true" />
        <X id="close-icon" class="w-6 h-6 hidden" aria-hidden="true" />
      </button>
    </div>
  </div>

  {/* Mobile Nav Content */}
  <div
    id="mobile-menu"
    class="lg:hidden w-full overflow-hidden transition-[max-height,opacity] duration-500 ease-in-out max-h-0 opacity-0 relative"
  >
    {/* Animated Background */}
    <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
      <div class="absolute inset-0 bg-background/95 backdrop-blur-xl"></div>
      <div
        class="absolute -top-[50%] -left-[50%] w-[200%] h-[200%] bg-[radial-gradient(circle_at_center,var(--primary)_0%,transparent_50%)] opacity-[0.03] animate-[spin_20s_linear_infinite]"
      >
      </div>
      <div
        class="absolute -bottom-[50%] -right-[50%] w-[200%] h-[200%] bg-[radial-gradient(circle_at_center,var(--secondary)_0%,transparent_50%)] opacity-[0.03] animate-[spin_15s_linear_infinite_reverse]"
      >
      </div>
    </div>

    <nav
      class="flex flex-col items-center gap-2 py-8 px-6 border-t border-white/5"
      aria-label="Mobile Navigation"
    >
      {
        LinkstoSections.map((item) => (
          <a
            href={getHref(item.href)}
            aria-label={item.label}
            class="mobile-link w-full text-center py-4 text-lg font-medium text-text-muted hover:text-white hover:bg-white/5 transition-all rounded-2xl group flex items-center justify-center gap-3"
          >
            <span>{item.name}</span>
            <span class="w-1.5 h-1.5 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity" />
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  /**
   * MOBILE MENU LOGIC
   */
  function initMobileMenu() {
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    if (!menuToggle || !mobileMenu || !menuIcon || !closeIcon) return;

    const toggleMenu = (show: boolean) => {
      const isExpanded = show;
      menuToggle.setAttribute("aria-expanded", isExpanded.toString());

      if (show) {
        mobileMenu.classList.replace("max-h-0", "max-h-[600px]");
        mobileMenu.classList.replace("opacity-0", "opacity-100");
        menuIcon.classList.replace("block", "hidden");
        closeIcon.classList.replace("hidden", "block");
        document.body.style.overflow = "hidden"; // Prevent scroll when menu open
      } else {
        mobileMenu.classList.replace("max-h-[600px]", "max-h-0");
        mobileMenu.classList.replace("opacity-100", "opacity-0");
        menuIcon.classList.replace("hidden", "block");
        closeIcon.classList.replace("block", "hidden");
        document.body.style.overflow = "";
      }
    };

    menuToggle.addEventListener("click", () => {
      const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
      toggleMenu(!isExpanded);
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => toggleMenu(false));
    });

    // Close on escape
    window.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        menuToggle.getAttribute("aria-expanded") === "true"
      ) {
        toggleMenu(false);
      }
    });
  }

  /**
   * SCROLL SPY (INTERSECTION OBSERVER) LOGIC
   */
  function initScrollSpy() {
    const sectionIds = [
      "nav.home",
      "nav.about",
      "nav.projects",
      "nav.skills",
      "nav.certifications",
      "nav.contact",
    ];
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((s) => s !== null) as HTMLElement[];
    const desktopLinks = document.querySelectorAll(".nav-link");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    if (sections.length === 0) return;

    const observerOptions = {
      root: null,
      rootMargin: "-20% 0px -60% 0px",
      threshold: 0,
    };

    const updateActiveLink = (id: string) => {
      const allLinks = [...desktopLinks, ...mobileLinks];
      allLinks.forEach((link) => {
        const isActive = link.getAttribute("aria-label") === id;
        link.classList.toggle("text-white", isActive);
        link.classList.toggle("text-text-muted", !isActive);

        const dot = link.querySelector("span.bg-white\\/5, span.bg-primary");
        if (dot) {
          if (link.classList.contains("nav-link")) {
            dot.classList.toggle("opacity-100", isActive);
            dot.classList.toggle("scale-100", isActive);
          } else {
            dot.classList.toggle("opacity-100", isActive);
          }
        }
      });
    };

    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          updateActiveLink(entry.target.id);
        }
      });
    };

    const observer = new IntersectionObserver(callback, observerOptions);
    sections.forEach((section) => observer.observe(section));

    return observer;
  }

  // Initialize on page load
  document.addEventListener("astro:page-load", () => {
    initMobileMenu();
    const spyObserver = initScrollSpy();

    // Performance: Disconnect observer when tab is inactive
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") {
        spyObserver?.disconnect();
      } else {
        // Re-observe
        const sectionIds = [
          "nav.home",
          "nav.about",
          "nav.projects",
          "nav.skills",
          "nav.certifications",
          "nav.contact",
        ];
        sectionIds.forEach((id) => {
          const el = document.getElementById(id);
          if (el) spyObserver?.observe(el);
        });
      }
    });
  });
</script>
