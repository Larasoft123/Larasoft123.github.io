---
import MenuBtn from "@/assets/icons/MenuBtn.astro";
import SocialLink from "./SocialLink.astro";
import Git from "@/assets/Logos/Git.svg";
const URL = Astro.url.pathname;
const isHome = URL === "/";

const LinkstoSections = [
  {
    name: "Home",
    href: `${isHome ? " #Intro" : "/"}`,
    label: "Intro",
  },
  {
    name: "Projects",
    href: `${isHome ? " #projects" : "/#projects"}`,
    label: "projects",
  },
  {
    name: "Skills",
    href: `${isHome ? "#skills" : "/#skills"}`,
    label: "skills",
  },
];
---

<header
  class="flex items-center min-h-20 justify-between whitespace-nowrap border-b border-white/10 dark:border-white/10 px-10 py-4"
  style="animation-delay: 1.2s;"
>
  <div class="flex items-center gap-3">
    <div class="size-6 text-primary">
      <svg
        fill="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5-10-5-10 5z"></path>
      </svg>
    </div>
    <h2 class="text-xl font-bold text-white">DevPortfolio</h2>
  </div>
  <nav class="hidden md:flex items-center gap-8 font-medium">
    <ul class="md:flex items-center gap-8 font-medium">
      {
        LinkstoSections.map(({ name, href, label }) => (
          <li class="nav-link text-md  text-gray-300 hover:text-primary dark:hover:text-primary transition-colors">
            <a href={href} aria-label={`${label}`}>
              {name}
            </a>
          </li>
        ))
      }
      <!-- <a
        class="nav-link text-gray-300 hover:text-primary dark:hover:text-primary transition-colors"
        href="#">About Me</a
      >
      <a
        class="nav-link text-gray-300 hover:text-primary dark:hover:text-primary transition-colors"
        href="#">Projects</a
      >
      <a
        class="nav-link text-gray-300 hover:text-primary dark:hover:text-primary transition-colors"
        href="#">Skills</a
      >
      <a
        class="nav-link text-gray-300 hover:text-primary dark:hover:text-primary transition-colors"
        href="#">Certifications</a
      >
      <a
        class="nav-link text-gray-300 hover:text-primary dark:hover:text-primary transition-colors"
        href="#">Contact</a -->
    </ul>
  </nav>
  <div class="flex items-center gap-4">
    <div
      class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10"
      style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuDF3eLc7SG41Qar0srRlfxrh3x4RQ9wzXt_95MKcFGQYK1UiCeWWd-RuacevNfK6USgJQOJkV-qHsT8XVcoDY6TSPb4E7N478BIbBihtGVqeEaL0zifBIrwfsTft60z6wltdBbL-gFx5oWKq35T0x7gth0fuuAAR5v1cgY8pDckhqNPJyPwEpEipFCN004rfr-VNCLFcCzSdvsEkBvWVpSXSu5KDD27aW2mDMMfzieOIdlT4WjAtLH-FXmuN5VbwReT3xG5o1v5P_8c");'
    >
    </div>

    <MenuBtn class="md:hidden text-white" />

    <SocialLink href="" name="github">
      <Git class={"w-6"} />
    </SocialLink>
  </div>
</header>

<!-- intersection observer -->
<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const linksHeader = document.querySelectorAll("header nav a");

    const options = {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    };

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          linksHeader.forEach((item) => {
            const label = item.getAttribute("aria-label");

            if (label == entry.target.id) {
              item.classList.add("text-primary");
            } else {
              item.classList.remove("text-primary");
            }
          });
        }
      });
    };

    let observer = new IntersectionObserver(callback, options);

    sections.forEach((section) => {
      observer.observe(section);
    });

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>
