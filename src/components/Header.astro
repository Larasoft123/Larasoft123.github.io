---
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "@/i18n/utils";
import LanguagePicker from "@/components/i18N/languagePicker.astro";
import { type Language } from "@/types/types";
import { Code, Menu, X } from "@lucide/astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang as Language);

const navItems = [
  { key: "nav.home", href: "#nav.home" },
  { key: "nav.projects", href: "#nav.projects" },
  { key: "nav.skills", href: "#nav.skills" },
  { key: "nav.certifications", href: "#nav.certifications" },
  { key: "nav.contact", href: "#nav.contact" },
];

const LinkstoSections = navItems.map((item) => ({
  name: t(item.key),
  href: item.href.startsWith("#") ? item.href : translatePath(item.href),
  label: item.key,
}));

const homeLink = lang === "es" ? "/" : `/${lang}/`;

const getHref = (href: string) => {
  if (href.startsWith("#")) return `${homeLink}${href}`;
  return href;
};
---

<header
  id="main-header"
  class="nav-animate flex flex-col items-center border border-transparent transition-all duration-300 z-50"
  role="banner"
>
  <div
    class="flex justify-between lg:grid lg:grid-cols-[1fr_auto_1fr] items-center w-full px-6 lg:px-8"
  >
    {/* Logo (Left) */}
    <div class="flex justify-start">
      <a
        href={homeLink}
        class="flex items-center gap-2 group cursor-pointer"
        aria-label="Larasoft Home"
      >
        <div
          class="p-2 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-xl border border-white/10 group-hover:border-primary/50 transition-colors"
        >
          <Code class="text-primary w-5 h-5" aria-hidden="true" />
        </div>
        <span
          class="hidden sm:block text-lg font-black text-text-main tracking-tighter font-display"
        >
          Larasoft
        </span>
      </a>
    </div>

    {/* Desktop Nav (Center) */}
    <nav
      class="hidden lg:flex justify-center items-center gap-1"
      aria-label="Desktop Navigation"
    >
      {
        LinkstoSections.map((item) => (
          <a
            href={getHref(item.href)}
            aria-label={item.name}
            data-i18n={item.label}
            class="px-5 py-2 text-sm font-semibold text-text-muted hover:text-white transition-colors relative group"
          >
            {item.name}

            <span class="absolute inset-0 bg-primary/10 rounded-full opacity-0 group-hover:opacity-100 transition-all duration-300" />
          </a>
        ))
      }
    </nav>

    {/* Actions (Right) */}
    <div class="flex justify-end items-center gap-3">
      <LanguagePicker />

      <button
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle Mobile Menu"
        class="lg:hidden text-text-main p-2 hover:bg-white/5 rounded-full transition-colors focus:outline-none z-50"
      >
        <Menu id="menu-icon" class="w-6 h-6 block" />
        <X id="close-icon" class="w-6 h-6 hidden" />
      </button>
    </div>
  </div>

  {/* Mobile Nav Content */}
  <div
    id="mobile-menu"
    class="lg:hidden w-full overflow-hidden transition-all duration-300 ease-in-out max-h-0 bg-[#0f172ae6]"
  >
    <div class="w-full h-px bg-white/10 my-2"></div>
    <nav class="flex flex-col items-center gap-2 py-4 px-6">
      {
        LinkstoSections.map((item) => (
          <a
            href={getHref(item.href)}
            aria-label={item.name}
            data-i18n={item.label}
            class="mobile-link w-full text-center py-3 text-base font-medium text-text-muted hover:text-white hover:bg-white/5 transition-all rounded-xl"
          >
            {item.name}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    // Mobile Menu Logic
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");
    const mobileLinks = document.querySelectorAll(".mobile-link");
    const header = document.getElementById("main-header");

    if (menuToggle && mobileMenu && menuIcon && closeIcon && header) {
      const toggleMenu = () => {
        const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
        const newExpanded = !isExpanded;

        menuToggle.setAttribute("aria-expanded", newExpanded.toString());
        const maxHeight = newExpanded ? `${mobileMenu.scrollHeight}px` : "0";
        mobileMenu.style.maxHeight = maxHeight;
        mobileMenu.classList.toggle("max-h-0");
        header.classList.toggle("bg-[#0f172ae6]!");
        menuIcon.classList.toggle("hidden", newExpanded);
        closeIcon.classList.toggle("hidden", !newExpanded);
      };

      menuToggle.addEventListener("click", toggleMenu);

      mobileLinks.forEach((link) => {
        link.addEventListener("click", toggleMenu);
      });
    }

    
    // Selection of sections for Intersection Observer
    const sectionIds = [
      "nav.home",
      "nav.projects",
      "nav.skills",
      "nav.certifications",
      "nav.contact",
    ];
    
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((section) => section !== null);

    const linksHeader = document.querySelectorAll("header nav a");

    const options = {
      root: null,
      rootMargin: "0px 0px 0px 0px",
      threshold: 0,
    };

    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          linksHeader.forEach((link) => {
            link.classList.remove("text-white");
            const dot = link.querySelector("span.bg-primary\\/10");
            dot?.classList.remove("opacity-100");
          });

          const id = entry.target.id;
          const activeLink = document.querySelector(
            `header nav a[data-i18n="${id}"]`,
          );

          if (activeLink) {
            activeLink.classList.add("text-white");
            const dot = activeLink.querySelector("span.bg-primary\\/10");
            dot?.classList.add("opacity-100");
          }
        }
      });
    };

    const observer = new IntersectionObserver(callback, options);

    sections.forEach((section) => {
      observer.observe(section);
    });

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>
