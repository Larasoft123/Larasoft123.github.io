---
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "@/i18n/utils";
import LanguagePicker from "@/components/i18N/languagePicker.astro";
import { type Language } from "@/types/types";
import { Code, Menu, Globe } from "@lucide/astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang as Language);

const navItems = [
  { key: "nav.home", href: "#nav.home" },
  { key: "nav.about", href: "#nav.about" },
  { key: "nav.projects", href: "#nav.projects" },
  { key: "nav.skills", href: "#nav.skills" },
  { key: "nav.certifications", href: "#nav.certifications" },
  { key: "nav.contact", href: "#nav.contact" },
];

const LinkstoSections = navItems.map((item) => ({
  // @ts-ignore
  name: t(item.key),
  href: item.href.startsWith("#") ? item.href : translatePath(item.href),
  label: item.key,
}));

const homeLink = lang === "es" ? "/" : `/${lang}/`;

const getHref = (href: string) => {
  if (href.startsWith("#")) return `${homeLink}${href}`;
  return href;
};
---

<header
  class="nav-animate flex justify-between md:grid md:grid-cols-[1fr_auto_1fr] items-center px-6 md:px-8 border border-transparent transition-colors z-50"
>
  {/* Logo (Left) */}
  <div class="flex justify-start">
    <div class="flex items-center gap-2 group cursor-pointer">
      <div
        class="p-2 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-xl border border-white/10 group-hover:border-primary/50 transition-colors"
      >
        <Code class="text-primary w-5 h-5" />
      </div>
      <span
        class="hidden sm:block text-lg font-bold bg-clip-text text-transparent bg-gradient-to-r from-white to-white/70"
      >
        Larasoft
      </span>
    </div>
  </div>

  {/* Desktop Nav (Center) */}
  <nav class="hidden md:flex justify-center items-center gap-1">
    {
      LinkstoSections.map((item, idx) => (
        <a
          href={getHref(item.href)}
          aria-label={item.label}
          class="px-5 py-2 text-sm font-medium text-text-muted hover:text-white transition-colors relative group"
        >
          {item.name}

          <span class="absolute inset-0 bg-white/5 rounded-full scale-90 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300" />
        </a>
      ))
    }
  </nav>

  {/* Actions (Right) */}
  <div class="flex justify-end items-center gap-3">
    <LanguagePicker />

    <button
      class="md:hidden text-text-main p-2 hover:bg-white/5 rounded-full transition-colors"
    >
      <Menu class="w-5 h-5" />
    </button>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    // Select specific sections by ID to ensure we watch exactly what matters
    const sectionIds = [
      "nav.home",
      "nav.about",
      "nav.projects",
      "nav.skills",
      "nav.certifications",
      "nav.contact",
    ];

    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((section) => section !== null);

    const linksHeader = document.querySelectorAll("header nav a");

    const options = {
      root: null,
      // Adjust rootMargin to trigger when the section crosses the middle of the viewport
      rootMargin: "-20% 0px -60% 0px",
      threshold: 0,
    };

    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          // 1. Deactivate all links
          linksHeader.forEach((link) => {
            link.classList.remove("text-white");
            // Also remove the dot indicator logic if it was used
            const dot = link.querySelector("span.bg-white\\/5");
            if (dot) dot.classList.remove("opacity-100", "scale-100");
          });

          // 2. Activate the current link
          const id = entry.target.id;
          const activeLink = document.querySelector(
            `header nav a[aria-label="${id}"]`
          );

          if (activeLink) {
            activeLink.classList.add("text-white");
            // Add dot indicator logic if needed
            const dot = activeLink.querySelector("span.bg-white\\/5");
            if (dot) dot.classList.add("opacity-100", "scale-100");
          }
        }
      });
    };

    const observer = new IntersectionObserver(callback, options);

    sections.forEach((section) => {
      observer.observe(section);
    });

    // Cleanup
    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>
