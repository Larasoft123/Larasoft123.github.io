---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
---

<!doctype html>
<html lang="es" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />

    <title>Portfolio</title>
  </head>
  <body class="dark:bg-theme-background w-screen h-[200%]  overflow-x-hidden dark:text-theme-text">
    <Header />
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
