---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  description: string;
  title: string,
}

const { description,title } = Astro.props;
---

<!doctype html>
<html lang="es" class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="keywords"
      content="Astro, AstroJs, Portafolio, Portfolio, AnimeJS, Javascript, Js, Ts, Typerscript, Css, HTML, TailwindCss, View Transitions Api, La Velada, Juego de Memoria, Skills, Proyects"
    />
    <meta name="description" content={description} />
    <ClientRouter />

    <title>{title}</title>
  </head>
  <body class="bg-theme-background w-screen overflow-x-hidden text-theme-text">
    <Header transition:persist />
    <slot />
    <Footer transition:persist />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
